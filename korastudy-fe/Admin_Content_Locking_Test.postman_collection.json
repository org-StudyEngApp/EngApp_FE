		{
			"name": "1. Admin Lock/Unlock Exam",
			"item": [
				{
					"name": "Get All Exams",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.data && jsonData.data.content && jsonData.data.content.length > 0) {",
									"        var firstExam = jsonData.data.content[0];",
									"        pm.collectionVariables.set(\"test_exam_id\", firstExam.id);",
									"        console.log(\"✅ Test exam ID saved: \" + firstExam.id);",
									"        console.log(\"Exam title: \" + firstExam.title);",
									"        console.log(\"Is locked: \" + firstExam.isLocked);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/v1/admin/exams?page=0&size=10",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"admin",
								"exams"
							],
							"query": [
								{
									"key": "page",
									"value": "0"
								},
								{
									"key": "size",
									"value": "10"
								}
							]
						},
						"description": "Lấy danh sách exams để chọn 1 exam test"
					},
					"response": []
				},
				{
					"name": "Lock Exam",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Exam is locked\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.isLocked).to.eql(true);",
									"    console.log(\"✅ Exam locked successfully\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "PATCH",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/v1/admin/exams/{{test_exam_id}}/lock?isLocked=true",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"admin",
								"exams",
								"{{test_exam_id}}",
								"lock"
							],
							"query": [
								{
									"key": "isLocked",
									"value": "true"
								}
							]
						},
						"description": "Admin khóa bài thi - chỉ PREMIUM users mới access được (hoặc FREE users có grant)"
					},
					"response": []
				},
				{
					"name": "Unlock Exam",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Exam is unlocked\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.isLocked).to.eql(false);",
									"    console.log(\"✅ Exam unlocked - public for all users\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "PATCH",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/v1/admin/exams/{{test_exam_id}}/lock?isLocked=false",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"admin",
								"exams",
								"{{test_exam_id}}",
								"lock"
							],
							"query": [
								{
									"key": "isLocked",
									"value": "false"
								}
							]
						},
						"description": "Admin mở khóa bài thi - tất cả users đều access được"
					},
					"response": []
				}
			]
		},
